{
  "title": "Prompt Vault — Schema and API Reference",
  "version": "1.0",
  "purpose": "Complete reference for database tables, fields, and API endpoints.",
  "database": {
    "tables": {
      "generations": {
        "note": "This is the prompts table. The name 'generations' is legacy from the initial scaffold.",
        "columns": {
          "id": { "type": "serial", "pk": true, "note": "Auto-increment" },
          "title": { "type": "text", "required": true },
          "content": { "type": "text", "note": "Markdown body of the prompt" },
          "tags": { "type": "text[]", "note": "Array of tag strings" },
          "category": { "type": "text", "note": "Optional category label" },
          "starred": { "type": "boolean", "default": false },
          "notes": { "type": "text", "note": "Private notes, not part of the prompt content" },
          "collectionId": { "type": "integer", "fk": "collections.id", "nullable": true },
          "sourceFile": { "type": "text", "note": "Filename if imported from vault folder" },
          "updatedAt": { "type": "timestamp", "auto": true }
        }
      },
      "collections": {
        "columns": {
          "id": { "type": "serial", "pk": true },
          "name": { "type": "text", "required": true },
          "description": { "type": "text", "nullable": true },
          "color": { "type": "text", "note": "Hex color for UI display" },
          "icon": { "type": "text", "note": "Icon name from lucide-react" },
          "promptCount": { "type": "integer", "note": "Denormalized count, updated on prompt changes" }
        }
      }
    }
  },
  "api_routes": {
    "prompts": [
      {
        "method": "GET",
        "path": "/api/prompts",
        "query_params": ["search", "tag", "category", "collectionId", "starred"],
        "returns": "Prompt[]"
      },
      { "method": "POST", "path": "/api/prompts", "body": "InsertPrompt", "returns": "Prompt" },
      { "method": "GET", "path": "/api/prompts/:id", "returns": "Prompt" },
      { "method": "PUT", "path": "/api/prompts/:id", "body": "Partial<InsertPrompt>", "returns": "Prompt" },
      { "method": "DELETE", "path": "/api/prompts/:id", "returns": "{ success: true }" }
    ],
    "collections": [
      { "method": "GET", "path": "/api/collections", "returns": "Collection[]" },
      { "method": "POST", "path": "/api/collections", "body": "InsertCollection", "returns": "Collection" },
      { "method": "PUT", "path": "/api/collections/:id", "body": "Partial<InsertCollection>", "returns": "Collection" },
      { "method": "DELETE", "path": "/api/collections/:id", "returns": "{ success: true }" }
    ],
    "ai": [
      { "method": "POST", "path": "/api/ai/chat", "body": "{ messages: Message[], provider: string, model: string }", "returns": "Streaming text response" },
      { "method": "GET", "path": "/api/ai/models", "returns": "{ provider: string, models: string[] }[]" }
    ],
    "import": [
      { "method": "POST", "path": "/api/import/markdown", "body": "{ filename: string, content: string, collectionId?: number }", "returns": "Prompt" }
    ],
    "mcp": [
      { "method": "GET", "path": "/api/mcp/servers", "returns": "MCPServer[]" },
      { "method": "POST", "path": "/api/mcp/servers", "body": "{ name: string, url: string }", "returns": "MCPServer" },
      { "method": "DELETE", "path": "/api/mcp/servers/:id", "returns": "{ success: true }" },
      { "method": "GET", "path": "/api/mcp/servers/:id/tools", "returns": "MCPTool[]" }
    ]
  },
  "route_constants_file": "shared/routes.ts",
  "note": "Always use route constants from shared/routes.ts. Never hardcode path strings in components or hooks."
}
